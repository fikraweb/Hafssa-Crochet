{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hafssaacrochet",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "main": "server/worker.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "ShopStore",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-shop-dashboard",
      "new_sqlite_classes": ["ShopStore"],
    },
  ],
}
